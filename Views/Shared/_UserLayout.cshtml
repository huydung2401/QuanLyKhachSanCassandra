<!DOCTYPE html>

<html lang="vi">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>
        @ViewBag.Title - Sunrise Hotel
    </title>


    <!-- Bootstrap -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@3.4.1/dist/css/bootstrap.min.css" />


    <!-- Font Awesome -->

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />


    <!-- User CSS -->

    <link rel="stylesheet"
          href="@Url.Content("~/Content/user.css?v=2")" />

</head>


<body>


    <!-- =====================================================
         TOP BAR
         ===================================================== -->

    <div class="top-bar">

        <div class="user-container top-bar-inner">

            <div>

                <span>
                    <i class="fa-solid fa-phone"></i>
                    0900 123 456
                </span>

                <span>
                    <i class="fa-solid fa-envelope"></i>
                    contact@sunrisehotel.vn
                </span>

            </div>


            <div>

                <span>
                    <i class="fa-solid fa-clock"></i>
                    Lễ tân hoạt động 24/7
                </span>

            </div>

        </div>

    </div>



    <!-- =====================================================
         NAVBAR
         ===================================================== -->

    <header class="main-navbar">

        <div class="user-container navbar-inner">


            <!-- LOGO -->

            <a href="@Url.Action("Index", "UserHome")"
               class="hotel-logo">

                <div class="hotel-logo-icon">

                    <i class="fa-solid fa-hotel"></i>

                </div>


                <div>

                    <strong>
                        SUNRISE
                    </strong>

                    <small>
                        HOTEL
                    </small>

                </div>

            </a>



            <!-- MENU -->

            <nav class="main-menu">

                <a href="@Url.Action("Index", "UserHome")">
                    Trang chủ
                </a>

                <a href="#about">
                    Giới thiệu
                </a>

                <a href="#rooms">
                    Phòng
                </a>

                <a href="#services">
                    Dịch vụ
                </a>

                <a href="#gallery">
                    Hình ảnh
                </a>

                <a href="#contact">
                    Liên hệ
                </a>

            </nav>



            <!-- BOOK -->

            <a href="@Url.Action("Lookup", "UserBooking")"
               class="header-book-btn">

                <i class="fa-solid fa-magnifying-glass"></i>

                TRA CỨU

            </a>

        </div>

    </header>



    <!-- =====================================================
         CONTENT
         ===================================================== -->

    @RenderBody()



    <!-- =====================================================
         FOOTER
         ===================================================== -->

    <footer id="contact"
            class="main-footer">

        <div class="user-container">

            <div class="footer-grid">


                <!-- HOTEL -->

                <div class="footer-column">

                    <div class="footer-logo">

                        <div class="hotel-logo-icon">

                            <i class="fa-solid fa-hotel"></i>

                        </div>

                        <strong>
                            SUNRISE HOTEL
                        </strong>

                    </div>

                    <p>
                        Không gian lưu trú hiện đại,
                        dịch vụ chuyên nghiệp và trải nghiệm
                        đáng nhớ cho mọi hành trình.
                    </p>


                    <div class="social-links">

                        <a href="#">
                            <i class="fa-brands fa-facebook-f"></i>
                        </a>

                        <a href="#">
                            <i class="fa-brands fa-instagram"></i>
                        </a>

                        <a href="#">
                            <i class="fa-brands fa-tiktok"></i>
                        </a>

                    </div>

                </div>



                <!-- LINKS -->

                <div class="footer-column">

                    <h4>
                        Khách sạn
                    </h4>

                    <a href="#about">
                        Về chúng tôi
                    </a>

                    <a href="#rooms">
                        Phòng nghỉ
                    </a>

                    <a href="#services">
                        Dịch vụ
                    </a>

                    <a href="#gallery">
                        Hình ảnh
                    </a>

                </div>



                <!-- SUPPORT -->

                <div class="footer-column">

                    <h4>
                        Hỗ trợ
                    </h4>

                    <a href="#booking">
                        Đặt phòng
                    </a>

                    <a href="#">
                        Chính sách đặt phòng
                    </a>

                    <a href="#">
                        Chính sách hủy
                    </a>

                    <a href="#">
                        Câu hỏi thường gặp
                    </a>

                </div>



                <!-- CONTACT -->

                <div class="footer-column">

                    <h4>
                        Liên hệ
                    </h4>

                    <p>
                        <i class="fa-solid fa-location-dot"></i>
                        TP. Hồ Chí Minh, Việt Nam
                    </p>

                    <p>
                        <i class="fa-solid fa-phone"></i>
                        0900 123 456
                    </p>

                    <p>
                        <i class="fa-solid fa-envelope"></i>
                        contact@sunrisehotel.vn
                    </p>

                </div>

            </div>


            <div class="footer-bottom">

                <span>
                    © 2026 Sunrise Hotel.
                    All rights reserved.
                </span>

                <span>
                    Designed for Hotel Management System
                </span>

            </div>

        </div>

    </footer>



    <!-- Bootstrap JS -->

    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@3.4.1/dist/js/bootstrap.min.js"></script>


    @RenderSection(
        "scripts",
        required: false
    )

</body>

</html>