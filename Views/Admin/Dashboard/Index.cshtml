@model QuanLyKhachSan.Models.DashboardViewModel

@{
    ViewBag.Title = "Tổng quan";

    var occupiedRooms =
        Model.TotalRooms - Model.AvailableRooms;

    if (occupiedRooms < 0)
    {
        occupiedRooms = 0;
    }

    double occupancyRate =
        Model.TotalRooms > 0
            ? ((double)occupiedRooms / Model.TotalRooms) * 100
            : 0;

    string occupancyText =
        occupancyRate.ToString("0.0");
}


<!-- =========================================================
     DASHBOARD HEADER
     ========================================================= -->


<style>
/* =========================================================
   DASHBOARD - TĂNG CỠ CHỮ + GIAO DIỆN DỄ ĐỌC
   ========================================================= */

.dashboard-page {
    font-size: 16px;
    color: #172033;
}

/* Tiêu đề */
.dashboard-page .dashboard-title {
    font-size: 34px !important;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 10px;
}

.dashboard-page .dashboard-subtitle {
    font-size: 16px !important;
    line-height: 1.6;
}

/* Thông tin khách sạn */
.dashboard-page .dashboard-hotel-label {
    font-size: 15px !important;
    font-weight: 600;
}

.dashboard-page .dashboard-hotel-name {
    font-size: 23px !important;
    font-weight: 700;
    line-height: 1.4;
}

.dashboard-page .dashboard-hotel-location {
    font-size: 16px !important;
    line-height: 1.6;
}

.dashboard-page .dashboard-hotel-rating-text {
    font-size: 16px !important;
}

.dashboard-page .dashboard-hotel-edit {
    font-size: 16px !important;
    font-weight: 600;
}

/* KPI */
.dashboard-page .kpi-grid {
    gap: 18px;
}

.dashboard-page .kpi-card {
    min-height: 190px;
    padding: 23px !important;
}

.dashboard-page .kpi-label {
    font-size: 16px !important;
    font-weight: 600;
}

.dashboard-page .kpi-value {
    font-size: 38px !important;
    line-height: 1.2;
    font-weight: 700;
}

.dashboard-page .kpi-description {
    font-size: 14px !important;
    line-height: 1.5;
}

/* Tiêu đề các card */
.dashboard-page .card-title {
    font-size: 20px !important;
    font-weight: 700;
}

.dashboard-page .card-subtitle {
    font-size: 14px !important;
    line-height: 1.5;
}

/* Biểu đồ */
.dashboard-page .occupancy-percent {
    font-size: 27px !important;
    font-weight: 700;
}

.dashboard-page .occupancy-label {
    font-size: 14px !important;
}

.dashboard-page .legend-name {
    font-size: 15px !important;
}

.dashboard-page .legend-value {
    font-size: 15px !important;
    font-weight: 600;
}

/* Thao tác nhanh */
.dashboard-page .quick-action {
    padding: 18px !important;
    min-height: 115px;
}

.dashboard-page .quick-action-title {
    font-size: 16px !important;
    font-weight: 600;
}

.dashboard-page .quick-action-text {
    font-size: 14px !important;
    line-height: 1.5;
}

/* Trạng thái hệ thống */
.dashboard-page .system-item {
    padding: 18px !important;
}

.dashboard-page .system-item-title {
    font-size: 16px !important;
    font-weight: 600;
}

.dashboard-page .system-item-status {
    font-size: 14px !important;
}

/* Icon */
.dashboard-page .kpi-icon {
    width: 48px;
    height: 48px;
    font-size: 19px;
}

.dashboard-page .quick-action-icon {
    width: 42px;
    height: 42px;
    font-size: 17px;
}

/* Responsive */
@@media (max-width: 992px) {
    .dashboard-page .dashboard-title {
        font-size: 30px !important;
    }

    .dashboard-page .kpi-value {
        font-size: 34px !important;
    }
}

@@media (max-width: 768px) {
    .dashboard-page .dashboard-title {
        font-size: 27px !important;
    }

    .dashboard-page .dashboard-hotel-name {
        font-size: 20px !important;
    }

    .dashboard-page .kpi-value {
        font-size: 31px !important;
    }

    .dashboard-page .kpi-label {
        font-size: 15px !important;
    }
}
</style>

<div class="dashboard-page">

   

    <!-- =========================================================
         KPI
         ========================================================= -->

    <div class="kpi-grid">


        <!-- =====================================================
         ROOMS
         ===================================================== -->

        <a href="@Url.Action("Index", "Room")"
           class="kpi-card kpi-card-link">

            <div class="kpi-top">

                <div class="kpi-label">
                    Tổng số phòng
                </div>

                <div class="kpi-icon icon-green">

                    <i class="fa-solid fa-bed"></i>

                </div>

            </div>


            <div class="kpi-value">

                @Model.TotalRooms

            </div>


            <div class="kpi-description">

                Tổng số phòng trong khách sạn

            </div>

        </a>


        <!-- =====================================================
         AVAILABLE
         ===================================================== -->

        <a href="@Url.Action("Index", "Room")"
           class="kpi-card kpi-card-link">

            <div class="kpi-top">

                <div class="kpi-label">
                    Phòng đang trống
                </div>

                <div class="kpi-icon icon-orange">

                    <i class="fa-solid fa-door-open"></i>

                </div>

            </div>


            <div class="kpi-value">

                @Model.AvailableRooms

            </div>


            <div class="kpi-description">

                Có thể nhận đặt phòng

            </div>

        </a>


        <!-- =====================================================
         BOOKINGS
         ===================================================== -->

        <a href="@Url.Action("Index", "Booking")"
           class="kpi-card kpi-card-link">

            <div class="kpi-top">

                <div class="kpi-label">
                    Tổng booking
                </div>

                <div class="kpi-icon icon-purple">

                    <i class="fa-solid fa-calendar-check"></i>

                </div>

            </div>


            <div class="kpi-value">

                @Model.TotalBookings

            </div>


            <div class="kpi-description">

                Đặt phòng trong hệ thống

            </div>

        </a>
        <!-- =====================================================
    REVENUE
    ===================================================== -->

        <a href="@Url.Action("Index", "Invoice")"
           class="kpi-card kpi-card-link">

            <div class="kpi-top">

                <div class="kpi-label">
                    Doanh thu
                </div>

                <div class="kpi-icon icon-blue">

                    <i class="fa-solid fa-money-bill-wave"></i>

                </div>

            </div>


            <div class="kpi-value kpi-revenue-value">

                @Model.TotalRevenue.ToString("N0") ₫

            </div>


            <div class="kpi-description">

                Tổng doanh thu

            </div>

        </a>

    </div>


    <!-- =========================================================
         MAIN DASHBOARD
         ========================================================= -->

    <div class="dashboard-grid">


        <!-- =====================================================
             ROOM STATUS
             ===================================================== -->

        <div class="dashboard-card">

            <div class="card-header-custom">

                <div>

                    <h3 class="card-title">
                        Tình trạng phòng
                    </h3>

                    <div class="card-subtitle">
                        Tỷ lệ sử dụng phòng hiện tại
                    </div>

                </div>

            </div>


            <div class="card-body-custom">

                <div class="occupancy-container">


                    <!-- DONUT -->

                    <div class="occupancy-chart"
                         style="--occupancy: @occupancyText%;">

                        <div class="occupancy-inner">

                            <div class="occupancy-percent">
                                @occupancyText%
                            </div>

                            <div class="occupancy-label">
                                Đang sử dụng
                            </div>

                        </div>

                    </div>


                    <!-- LEGEND -->

                    <div class="occupancy-info">


                        <!-- OCCUPIED -->

                        <div class="legend-row">

                            <span class="legend-dot legend-blue"></span>

                            <span class="legend-name">
                                Đang sử dụng
                            </span>

                            <span class="legend-value">
                                @occupiedRooms
                            </span>

                        </div>


                        <!-- AVAILABLE -->

                        <div class="legend-row">

                            <span class="legend-dot legend-gray"></span>

                            <span class="legend-name">
                                Phòng trống
                            </span>

                            <span class="legend-value">
                                @Model.AvailableRooms
                            </span>

                        </div>


                        <!-- TOTAL -->

                        <div class="legend-row">

                            <span class="legend-dot"
                                  style="background:#94a3b8;">
                            </span>

                            <span class="legend-name">
                                Tổng phòng
                            </span>

                            <span class="legend-value">
                                @Model.TotalRooms
                            </span>

                        </div>


                    </div>

                </div>

            </div>

        </div>


        <!-- =====================================================
             QUICK ACTIONS
             ===================================================== -->

        <div class="dashboard-card">

            <div class="card-header-custom">

                <div>

                    <h3 class="card-title">
                        Thao tác nhanh
                    </h3>

                    <div class="card-subtitle">
                        Truy cập nhanh các chức năng
                    </div>

                </div>

            </div>


            <div class="card-body-custom">

                <div class="quick-actions">


                    <!-- =================================================
                         HOTEL
                         ================================================= -->

                    <a href="@Url.Action("Index", "Hotel")"
                       class="quick-action">

                        <div class="quick-action-icon">

                            <i class="fa-solid fa-hotel"></i>

                        </div>


                        <div class="quick-action-title">
                            Thông tin khách sạn
                        </div>


                        <div class="quick-action-text">
                            Xem và chỉnh sửa thông tin
                        </div>

                    </a>


                    <!-- =================================================
                         ROOM
                         ================================================= -->

                    <a href="@Url.Action("Create", "Room")"
                       class="quick-action">

                        <div class="quick-action-icon">

                            <i class="fa-solid fa-bed"></i>

                        </div>


                        <div class="quick-action-title">
                            Thêm phòng
                        </div>


                        <div class="quick-action-text">
                            Tạo phòng mới
                        </div>

                    </a>


                    <!-- =================================================
                         GUEST
                         ================================================= -->

                    <a href="@Url.Action("Create", "Guest")"
                       class="quick-action">

                        <div class="quick-action-icon">

                            <i class="fa-solid fa-user-plus"></i>

                        </div>


                        <div class="quick-action-title">
                            Thêm khách hàng
                        </div>


                        <div class="quick-action-text">
                            Tạo hồ sơ khách hàng
                        </div>

                    </a>


                    <!-- =================================================
                         BOOKING
                         ================================================= -->

                    <a href="@Url.Action("Create", "Booking")"
                       class="quick-action">

                        <div class="quick-action-icon">

                            <i class="fa-solid fa-calendar-plus"></i>

                        </div>


                        <div class="quick-action-title">
                            Tạo booking
                        </div>


                        <div class="quick-action-text">
                            Tạo đặt phòng mới
                        </div>

                    </a>


                </div>

            </div>

        </div>


    </div>


    <!-- =========================================================
         SYSTEM
         ========================================================= -->

    <div class="dashboard-card">

        <div class="card-header-custom">

            <div>

                <h3 class="card-title">
                    Trạng thái hệ thống
                </h3>

                <div class="card-subtitle">
                    Kiểm tra các thành phần đang hoạt động
                </div>

            </div>

        </div>


        <div class="card-body-custom">

            <div class="system-grid">


                <!-- DATABASE -->

                <div class="system-item">

                    <div class="system-item-icon">

                        <i class="fa-solid fa-database"></i>

                    </div>


                    <div>

                        <div class="system-item-title">
                            Astra DB
                        </div>

                        <div class="system-item-status">

                            <i class="fa-solid fa-circle"
                               style="font-size:6px;">
                            </i>

                            Connected

                        </div>

                    </div>

                </div>


                <!-- CASSANDRA -->

                <div class="system-item">

                    <div class="system-item-icon">

                        <i class="fa-solid fa-server"></i>

                    </div>


                    <div>

                        <div class="system-item-title">
                            Cassandra
                        </div>

                        <div class="system-item-status">

                            <i class="fa-solid fa-circle"
                               style="font-size:6px;">
                            </i>

                            Connected

                        </div>

                    </div>

                </div>


                <!-- MVC -->

                <div class="system-item">

                    <div class="system-item-icon">

                        <i class="fa-solid fa-code"></i>

                    </div>


                    <div>

                        <div class="system-item-title">
                            ASP.NET MVC 5
                        </div>

                        <div class="system-item-status">

                            <i class="fa-solid fa-circle"
                               style="font-size:6px;">
                            </i>

                            Running

                        </div>

                    </div>

                </div>


            </div>

        </div>

    </div>

</div>
