<script>

    /* =====================================================
       SEARCH VARIABLES
    ====================================================== */

    var searchInput =
        document.getElementById("roomSearch");

    var statusFilter =
        document.getElementById("statusFilter");

    var clearButton =
        document.getElementById("clearSearch");

    var roomRows =
        document.querySelectorAll(".room-row");

    var noSearchResult =
        document.getElementById("noSearchResult");

    var resultText =
        document.getElementById("roomResultText");

    var totalRoomCount =
        document.getElementById("totalRoomCount");


    /* =====================================================
       FILTER ROOMS
    ====================================================== */

    function filterRooms() {

        var keyword =
            searchInput.value
                .toLowerCase()
                .trim();

        var selectedStatus =
            statusFilter.value
                .toLowerCase()
                .trim();

        var visibleCount = 0;


        roomRows.forEach(function (row) {

            var roomNumber =
                (row.getAttribute(
                    "data-room-number"
                ) || "")
                    .toLowerCase();

            var roomType =
                (row.getAttribute(
                    "data-room-type"
                ) || "")
                    .toLowerCase();

            var roomStatus =
                (row.getAttribute(
                    "data-room-status"
                ) || "")
                    .toLowerCase();


            /*
             * Tìm kiếm theo:
             * - Số phòng
             * - Loại phòng
             * - Trạng thái
             */

            var matchKeyword =
                keyword === "" ||
                roomNumber.indexOf(keyword) !== -1 ||
                roomType.indexOf(keyword) !== -1 ||
                roomStatus.indexOf(keyword) !== -1;


            /*
             * Lọc trạng thái
             */

            var matchStatus =
                selectedStatus === "" ||
                roomStatus === selectedStatus;


            if (matchKeyword && matchStatus) {

                row.style.display = "";

                visibleCount++;

            }
            else {

                row.style.display = "none";

            }

        });


        /* =========================================
           CLEAR BUTTON
        ========================================== */

        if (
            keyword !== "" ||
            selectedStatus !== ""
        ) {

            clearButton.style.display =
                "block";

        }
        else {

            clearButton.style.display =
                "none";

        }


        /* =========================================
           RESULT TEXT
        ========================================== */

        var totalCount =
            roomRows.length;


        if (
            keyword === "" &&
            selectedStatus === ""
        ) {

            resultText.textContent =
                "Hiển thị tất cả " +
                totalCount +
                " phòng";

        }
        else {

            resultText.textContent =
                "Tìm thấy " +
                visibleCount +
                "/" +
                totalCount +
                " phòng";

        }


        /* =========================================
           TOTAL BADGE
        ========================================== */

        totalRoomCount.textContent =
            visibleCount;


        /* =========================================
           NO RESULT
        ========================================== */

        if (visibleCount === 0) {

            noSearchResult.style.display =
                "block";

        }
        else {

            noSearchResult.style.display =
                "none";

        }

    }


    /* =====================================================
       CLEAR SEARCH
    ====================================================== */

    function clearRoomSearch() {

        searchInput.value = "";

        statusFilter.value = "";

        filterRooms();

        searchInput.focus();

    }


    /* =====================================================
       CLEAR BUTTON
    ====================================================== */

    clearButton.addEventListener(
        "click",
        function () {

            clearRoomSearch();

        }
    );


    /* =====================================================
       SEARCH EVENT
    ====================================================== */

    searchInput.addEventListener(
        "input",
        function () {

            filterRooms();

        }
    );


    /* =====================================================
       STATUS EVENT
    ====================================================== */

    statusFilter.addEventListener(
        "change",
        function () {

            filterRooms();

        }
    );


    /* =====================================================
       DELETE CONFIRM
    ====================================================== */

    function confirmDelete(roomNumber) {

        return confirm(
            "Bạn có chắc chắn muốn xóa phòng " +
            roomNumber +
            " không?\n\n" +
            "Ảnh của phòng cũng sẽ bị xóa khỏi hệ thống."
        );

    }


    /* =====================================================
       INITIALIZE
    ====================================================== */

    filterRooms();

</script>