            </p>

        </div>



        <div class="service-grid">


            <div class="service-card">

                <div class="service-icon">

                    <i class="fa-solid fa-wifi"></i>

                </div>

                <h3>
                    WiFi tốc độ cao
                </h3>

                <p>
                    Kết nối Internet miễn phí
